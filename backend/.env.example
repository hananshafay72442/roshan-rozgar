# MySQL 8.4 for local development. Fill in a password before starting.
APP_ENV=development
# Optional locally. Generate a random value for shared environments.
SECRET_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=roshanRozgar
DB_USER=roshan_app
DB_PASSWORD=
# Use DB_SSL=1 and the provider's CA for a hosted MySQL server.
DB_SSL=0
# Optional CA file path. The default uses the bundled public CA roots.
DB_CA_PATH=

# Seed fictional worker accounts, jobs and reviews. Set 0 for real users.
SEED_SAMPLE_DATA=1
# Create administrator accounts interactively with the create-admin command.

# Optional Gemini connection. Keep the real key in backend/.env, never in this file.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-3.5-flash-lite

# Primary verification channel. Use a sender on a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Allow on-screen codes on the local development database.
DEMO_VERIFICATION=1

# Optional alternative for Pakistani mobile numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

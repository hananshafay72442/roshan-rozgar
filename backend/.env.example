# Local development uses SQLite if DB_HOST is empty.
APP_ENV=development
# Optional locally. Generate a random value for shared environments.
SECRET_KEY=
DB_HOST=
DB_PORT=4000
DB_NAME=mandiwise
DB_USER=
DB_PASSWORD=
DB_SSL=1
# Optional CA file path. The default uses the bundled public CA roots.
DB_CA_PATH=

# Docker startup can add the organizers' fictional prices once.
SEED_SAMPLE_DATA=1
# Leave these empty and run the interactive create-admin command locally.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Without a key, MandiWise displays the exact calculation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

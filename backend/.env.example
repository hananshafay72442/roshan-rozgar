# Local development uses SQLite if DB_HOST is empty.
APP_ENV=development
# Optional locally. Generate a random value for shared environments.
SECRET_KEY=
DB_HOST=
DB_PORT=4000
DB_NAME=roshanRozgar
DB_USER=
DB_PASSWORD=
DB_SSL=1
# Optional CA file path. The default uses the bundled public CA roots.
DB_CA_PATH=

# Seed fictional worker accounts, jobs and reviews. Set 0 for real users.
SEED_SAMPLE_DATA=1
# Reserved for future admin accounts; leave empty. No create-admin command exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Gemini connection. Keep the real key in backend/.env, never in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# When the Twilio fields are all empty, local SQLite development displays a
# clearly labelled demo code in the browser. Set 0 to require live SMS.
# DEMO_VERIFICATION=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
